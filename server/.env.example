PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://root:root@localhost:3307/accessflow_v2"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=15583131
ALLOW_PRIVATE_TARGETS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AccessFlow <no-reply@accessflow.local>

# ML priority service (Module 2). Leave ML_SERVICE_URL empty to always use the axe-impact fallback.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace-with-the-same-key-as-ml-service
ML_TIMEOUT_MS=5000
# Development only: accept predictions from a synthetic/dev model (stored with a '+dev' version suffix)
ML_ACCEPT_DEV_MODEL=false
